[Unit]
Description=Generative AI Vdos Django backend
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/generative-ai-vdos
EnvironmentFile=/home/ubuntu/generative-ai-vdos/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.development
ExecStart=/home/ubuntu/generative-ai-vdos/.venv/bin/gunicorn config.wsgi:application --chdir backend --bind 127.0.0.1:8000 --workers 1 --timeout 120
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
