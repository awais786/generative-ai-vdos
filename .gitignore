# Secrets — never commit real keys; use .env.example as the template.
# Also enforced by scripts/git-hooks/pre-commit (see CLAUDE.md → Secrets).
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa
id_ed25519
credentials

# Python
.venv/
__pycache__/
*.pyc
# uv.lock is COMMITTED on purpose — it is what makes `uv sync` resolve the same
# dependency versions for everyone. Do not add it back here.

# Generated artifacts (videos, images, audio, state)
output/

# Local music library (drop royalty-free mp3s here)
music/

